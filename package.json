{
  "name": "@lomray/event-manager",
  "version": "1.0.0",
  "description": "This package provides event manager on typescript for any js project.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lomray-Software/event-manager"
  },
  "keywords": [
    "lomray",
    "javascript",
    "typescript",
    "event",
    "manager",
    "pattern",
    "emitter"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": "Mikhail Yarmaliuk",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Lomray-Software/event-manager/issues"
  },
  "homepage": "https://github.com/Lomray-Software/event-manager",
  "scripts": {
    "test": "vitest run",
    "build": "rollup -c",
    "prettier:format": "prettier --write 'src/**/*.{ts,tsx,*.ts,*tsx}'",
    "prettier:check": "prettier --check --debug-check 'src/**/*.{ts,tsx,*.ts,*tsx}'",
    "lint:check": "eslint \"{src,__tests__,__helpers__}/**/*.ts\"",
    "lint:format": "eslint --fix \"{src,__tests__,__helpers__}/**/*.ts\"",
    "ts:check": "tsc --project ./tsconfig.json --skipLibCheck --noemit",
    "prepare": "husky",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@lomray/eslint-config": "^5.0.3",
    "@lomray/prettier-config": "^3.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.2",
    "@types/sinon": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^8.57.0",
    "globals": "^17.12.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.8",
    "rollup": "^4.21.2",
    "semantic-release": "^25.0.9",
    "sinon": "^22.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
